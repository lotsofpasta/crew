# Copy to .env (setup.sh does it). Never commit .env.

# --- Branding -------------------------------------------------------------
BRAND_NAME=Crew
BRAND_TAGLINE=Your agents, in one room.

# --- Hub ------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Where people open it (used in alerts and to allow the host name). e.g. https://crew.example.com
PUBLIC_URL=http://127.0.0.1:8000
# Extra host names to serve (comma separated), e.g. crew.example.com
ALLOWED_HOSTS=
# Behind a reverse proxy / tunnel that sets X-Forwarded-For or Cf-Connecting-Ip: 1 (used for login rate limits)
TRUST_PROXY_HEADERS=0
# A request straight from this machine with no login gets this role: viewer (safe default) or owner
LOCAL_ROLE=viewer
# Owner's timezone for daily counters
CREW_TZ=UTC

# --- Sign-in (python -m crew setpass writes these) ------------------------
DASHBOARD_PASSWORD_HASH=
VIEWER_KEY=
# Optional second, view-only password (scrypt hash)
VIEWER_PASSWORD_HASH=

# --- Agents (python -m crew tokens writes AGENT_TOKEN_<KEY> for each agent in agents.yaml)
# An agent process needs only CREW_URL and its own token.
CREW_URL=http://127.0.0.1:8000
# Seconds between an agent's syncs (lower = snappier, more requests)
CREW_SYNC_EVERY=10

# --- LLM (agent side) -----------------------------------------------------
ANTHROPIC_API_KEY=
# Optional: a gateway that speaks the Anthropic API
# ANTHROPIC_BASE_URL=
CREW_MODEL=claude-opus-5-5
CREW_LIGHT_MODEL=claude-sonnet-5-5
CREW_EFFORT=high

# --- Telegram alerts (optional) -------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Which agent reports go out: crit, warn, info, approval
TELEGRAM_LEVELS=crit,approval
